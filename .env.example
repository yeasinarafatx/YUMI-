# ─────────────────────────────────────────────────────────────
# YUME Jewellery — environment variables
# Copy to `.env.local` for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. Variables prefixed NEXT_PUBLIC_ are
# exposed to the browser; everything else stays on the server.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for SEO, Open Graph, sitemap, admin links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 2) ───────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only! Used exclusively by the order-creation route. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram notifications (Phase 5) ─────────────────────────
# Store these as Supabase Edge Function secrets (or server env), never client-side.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret the DB webhook sends so the notifier can verify the caller
ORDER_WEBHOOK_SECRET=
